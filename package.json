{
  "name": "ai-desktop-organizer",
  "version": "1.3.5",
  "description": "AI 桌面整理 - 类似腾讯桌面整理的 AI 增强版桌面收纳工具",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build.mjs && electron .",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win --x64",
    "smoke": "node scripts/build.mjs && electron . --smoke-test --no-sandbox",
    "check:emoji": "python3 scripts/check-emoji.py",
    "test": "node scripts/test-unit.mjs",
    "build:helper": "bash scripts/build-helper.sh"
  },
  "author": "Allen Thompson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "remixicon": "^4.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "pinyin-pro": "^3.29.4"
  },
  "productName": "AI Desktop",
  "build": {
    "appId": "com.aidesktop.organizer",
    "productName": "AI Desktop",
    "copyright": "MIT",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AI-Desktop-${version}-win-${arch}.${ext}",
      "executableName": "AIDesktop",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI桌面整理",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "AI-Desktop-Setup-${version}-x64.${ext}",
      "uninstallDisplayName": "AI桌面整理"
    },
    "portable": {
      "artifactName": "AI-Desktop-Portable-${version}-x64.${ext}"
    },
    "extraResources": [
      {
        "from": "native/AIDeskHelper.exe",
        "to": "helper/AIDeskHelper.exe"
      },
      {
        "from": "native/AIDeskHelper.cs",
        "to": "helper/AIDeskHelper.cs"
      }
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.28.2": true
  }
}
